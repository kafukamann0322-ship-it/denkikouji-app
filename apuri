    <button class="btn btn-primary btn-full" id="error-ok">OK</button>
  </div>
</div>

<!-- ====== 確認モーダル ====== -->
<div class="modal-overlay center" id="confirm-modal" style="display:none" role="dialog" aria-modal="true">
  <div class="modal-sheet modal-center">
    <div class="modal-header">
      <span class="modal-title" id="confirm-title">確認</span>
    </div>
    <div id="confirm-message" style="color:var(--text-secondary);font-size:14px;line-height:1.8;margin-bottom:20px"></div>
    <div style="display:flex;gap:12px">
      <button class="btn btn-secondary btn-full" id="confirm-cancel">キャンセル</button>
      <button class="btn btn-danger btn-full" id="confirm-ok">削除する</button>
    </div>
  </div>
</div>

<!-- ====== 写真プレビューモーダル ====== -->
<div class="modal-overlay center" id="photo-preview-modal" style="display:none" role="dialog" aria-modal="true">
  <div class="modal-sheet modal-center" style="padding:16px">
    <div style="display:flex;justify-content:flex-end;margin-bottom:8px">
      <button class="btn btn-icon btn-secondary btn-sm" id="preview-close">✕</button>
    </div>
    <img id="preview-img" alt="写真プレビュー" style="width:100%;border-radius:12px;margin-bottom:16px;max-height:60dvh;object-fit:contain">
    <div style="display:flex;gap:10px">
      <button class="btn btn-secondary btn-full" id="preview-retake">🔄 撮り直し</button>
      <button class="btn btn-danger btn-full" id="preview-delete">🗑️ 削除</button>
    </div>
  </div>
</div>

<!-- ====== 設定モーダル ====== -->
<div class="modal-overlay" id="settings-modal" style="display:none" role="dialog" aria-modal="true">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-header">
      <span class="modal-title">⚙️ 設定・マスター管理</span>
      <button class="btn btn-icon btn-secondary btn-sm" id="settings-close">✕</button>
    </div>

    <!-- LINEテキスト取り込み -->
    <div class="section-title">📱 LINEテキストから取り込み</div>
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px">
      LINEで共有されたマスターデータ（JSON）を貼り付けて「取り込み」を押してください。
    </div>
    <textarea id="line-import-text" class="input-field" placeholder='{"categories":[...],"materials":[...]}' style="min-height:100px;font-size:12px;font-family:monospace"></textarea>
    <button class="btn btn-primary btn-full" id="import-master-btn" style="margin-top:8px">📥 取り込む</button>

    <!-- LINE用テキストコピー -->
    <div class="section-title" style="margin-top:16px">📤 現在のマスターをLINEで共有</div>
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px">
      現在のマスターデータをクリップボードにコピーし、LINEで仲間に共有できます。
    </div>
    <button class="btn btn-outline btn-full" id="export-master-btn">📋 LINE用テキストをコピー</button>

    <!-- バージョン情報 -->
    <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--border);text-align:center;color:var(--text-muted);font-size:11px">
      施工写真管理アプリ v1.0<br>
      電気工事外線部門向け CALS/EC対応 PWA
    </div>
  </div>
</div>

<!-- ====== スクリプト ====== -->
<script type="module" src="./app.js"></script>

<script>
  // エラーモーダルのクローズ
  document.getElementById('error-close')?.addEventListener('click', () => {
    document.getElementById('error-modal').style.display = 'none';
  });
  document.getElementById('error-ok')?.addEventListener('click', () => {
    document.getElementById('error-modal').style.display = 'none';
  });

  // モーダル外タップで閉じる
  document.getElementById('settings-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('settings-modal')) {
      document.getElementById('settings-modal').style.display = 'none';
    }
  });
  document.getElementById('photo-preview-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('photo-preview-modal')) {
      document.getElementById('photo-preview-modal').style.display = 'none';
    }
  });

  // ヘッダータイトルをSPAに合わせて更新
  function updateHeader() {
    const hash = location.hash;
    const title = document.getElementById('app-title');
    const dateInput = document.getElementById('work-date');
    if (!hash || hash === '#home') {
      if (title) title.textContent = '⚡ 施工写真管理';
      if (dateInput) dateInput.style.display = '';
    } else {
      if (dateInput) dateInput.style.display = 'none';
    }
  }
  window.addEventListener('popstate', updateHeader);
  window.addEventListener('hashchange', updateHeader);

  // Service Worker の登録
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./sw.js')
        .then(registration => {
          console.log('ServiceWorker registration successful with scope: ', registration.scope);
        })
        .catch(err => {
          console.log('ServiceWorker registration failed: ', err);
        });
    });
  }
</script>
