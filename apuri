async function loadAggregatedMaterials(drawingId) {
  const poles = await getPolesByDrawing(drawingId);
  const categoriesWithMaterials = [];

  for (const pole of poles) {
    const allCats = await getCategoriesByPole(pole.id);
    for (const cat of allCats) {
      const children = await getCategoriesByParent(cat.id);
      if (children.length === 0) {
        // 末端工種
        const mats = await getMaterialsByCategory(cat.id);
        if (mats.some(m => m.qty > 0)) {
          categoriesWithMaterials.push({
            categoryId: cat.id,
            poleName: pole.name,
            categoryPath: [cat.name],
            materials: mats.filter(m => m.qty > 0).map(m => ({ name: m.name, qty: m.qty }))
          });
        }
      }
    }
  }

  const adjustments = await getAdjustmentsByDrawing(drawingId);
  const manualAdjustments = adjustments.map(a => ({ materialName: a.materialName, manualQty: a.manualQty }));

  const aggregated = aggregateMaterials({ categoriesWithMaterials, manualAdjustments });

  const container = document.getElementById('agg-material-list');
  if (aggregated.length === 0) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">📦</div><div class="empty-text">材料データがありません</div></div>`;
    return;
  }

  container.innerHTML = aggregated.map(m => `
    <div class="material-item ${m.qty > 0 ? 'has-qty' : ''} ${m.isManual ? 'fixed-on' : ''}">
      <div style="display:flex;flex-direction:column;flex:1;min-width:0">
        <span class="material-name">${m.name}</span>
        ${m.isManual ? '<span style="font-size:10px;color:var(--accent-yellow)">手動調整済</span>' : ''}
      </div>
      <div class="qty-counter">
        <button class="qty-btn minus agg-minus" data-name="${m.name}" data-qty="${m.qty}">－</button>
        <span class="qty-display agg-qty" data-name="${m.name}">${m.qty}</span>
        <button class="qty-btn plus agg-plus" data-name="${m.name}" data-qty="${m.qty}">＋</button>
      </div>
      <span style="font-size:12px;color:var(--text-muted);min-width:16px">個</span>
    </div>
  `).join('');

  // 集計データをキャッシュ
  const aggMap = new Map(aggregated.map(m => [m.name, m.qty]));

  const updateAgg = async (name, delta) => {
    const current = aggMap.get(name) || 0;
    const newQty = Math.max(0, current + delta);
    aggMap.set(name, newQty);

    // 手動調整値を保存
    const adj = {
      id: `adj_${drawingId}_${name.replace(/\s/g, '_')}`,
      drawingId,
      materialName: name,
      manualQty: newQty,
      updatedAt: Date.now()
    };
    await safeSave(() => saveAdjustment(adj));

    // UI更新
    const qtyEl = container.querySelector(`.agg-qty[data-name="${name}"]`);
    if (qtyEl) qtyEl.textContent = newQty;

    // ボタンのdata-qty更新
    container.querySelectorAll(`[data-name="${name}"]`).forEach(el => {
      el.dataset.qty = newQty;
    });
  };

  container.querySelectorAll('.agg-minus').forEach(btn => {
    btn.addEventListener('click', () => updateAgg(btn.dataset.name, -1));
  });
  container.querySelectorAll('.agg-plus').forEach(btn => {
    btn.addEventListener('click', () => updateAgg(btn.dataset.name, 1));
  });
}

// ====== ZIP出力 ======
async function handleZipExport(drawingId) {
  showProgress('データ収集中...', 5);

  try {
    const drawing = { id: drawingId, name: getDrawingName(drawingId) };
    const poles = await getPolesByDrawing(drawingId);

    // 写真未撮影チェック
    const missingPhotos = [];
    const polesData = [];

    for (const pole of poles) {
      const allCats = await getCategoriesByPole(pole.id);
      const poleData = { id: pole.id, name: pole.name, categories: [] };

      for (const cat of allCats) {
        const children = await getCategoriesByParent(cat.id);
        if (children.length > 0) continue; // 末端のみ

        const photos = await getPhotosByCategory(cat.id);
        const catData = await getCategoryData(cat.id);
        const enabledStages = catData?.enabledStages || { '事前': true, '中': true, '事後': true };

        const catPhotos = { '事前': [], '中': [], '事後': [] };
        for (const photo of photos) {
          if (catPhotos[photo.stage]) catPhotos[photo.stage].push(photo);
        }

        // 未撮影チェック
        for (const stage of ['事前', '中', '事後']) {
          if (enabledStages[stage] && catPhotos[stage].length === 0) {
            missingPhotos.push(`電柱: ${pole.name} / 工種: ${cat.name} / ${stage}`);
          }
        }

        // パス名構築
        const pathNames = await buildCategoryPath(cat);

        poleData.categories.push({
          id: cat.id,
          name: cat.name,
          pathNames,
          photos: catPhotos
        });
      }
      polesData.push(poleData);
    }

    if (missingPhotos.length > 0) {
      hideProgress();
      showMissingPhotosError(missingPhotos);
      return;
    }

    updateProgress(20, 'PDF生成中...');

    // 材料集計
    const categoriesWithMaterials = [];
    for (const pole of poles) {
      const allCats = await getCategoriesByPole(pole.id);
      for (const cat of allCats) {
        const children = await getCategoriesByParent(cat.id);
        if (children.length === 0) {
          const mats = await getMaterialsByCategory(cat.id);
          categoriesWithMaterials.push({
            materials: mats.filter(m => m.qty > 0).map(m => ({ name: m.name, qty: m.qty }))
          });
        }
      }
    }
    const adjustments = await getAdjustmentsByDrawing(drawingId);
    const manualAdjustments = adjustments.map(a => ({ materialName: a.materialName, manualQty: a.manualQty }));
    const aggregated = aggregateMaterials({ categoriesWithMaterials, manualAdjustments });

    updateProgress(30, 'ZIP作成中...');

    const zipBlob = await generateZIP({
      drawingName: getDrawingName(drawingId),
      date: state.workDate,
      polesData,
      materials: aggregated,
      onProgress: (pct) => updateProgress(30 + pct * 0.7, 'ZIP作成中...')
    });

    hideProgress();
    const filename = `${state.workDate}_${getDrawingName(drawingId)}_施工写真.zip`;
    downloadFile(zipBlob, filename);
    showToast('ZIPファイルを出力しました', 'success');

  } catch (e) {
    hideProgress();
    showError('ZIP出力に失敗しました: ' + e.message);
    console.error(e);
  }
}

async function buildCategoryPath(cat) {
  const path = [cat.name];
  let current = cat;
  while (current.parentId) {
    const parent = await getCategoryData(current.parentId);
    if (!parent) break;
    path.unshift(parent.name);
    current = parent;
  }
  return path;
}

