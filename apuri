// UUID生成
function uid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2);
}

// ====== エラーハンドリング ======
function showError(message) {
  const overlay = document.getElementById('error-modal');
  document.getElementById('error-message').textContent = message;
  overlay.style.display = 'flex';
}

function showQuotaError() {
  showError('端末のストレージ容量が不足しています。不要な写真を削除するか、一度ZIPを出力してください。');
}

async function safeSave(fn) {
  try {
    return await fn();
  } catch (e) {
    if (e.message === 'QUOTA_EXCEEDED' || e.name === 'QuotaExceededError') {
      showQuotaError();
      return null;
    }
    throw e;
  }
}

// ====== 共通UI ======
function showProgress(msg = 'ZIP/PDF作成中...', pct = 0) {
  const overlay = document.getElementById('progress-overlay');
  document.getElementById('progress-message').textContent = msg;
  document.getElementById('progress-fill').style.width = pct + '%';
  overlay.style.display = 'flex';
}

function updateProgress(pct, msg) {
  document.getElementById('progress-fill').style.width = pct + '%';
  if (msg) document.getElementById('progress-message').textContent = msg;
}

function hideProgress() {
  document.getElementById('progress-overlay').style.display = 'none';
}

function showToast(message, type = 'info') {
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

// 確認ダイアログ
function confirm(title, message) {
  return new Promise(resolve => {
    const modal = document.getElementById('confirm-modal');
    document.getElementById('confirm-title').textContent = title;
    document.getElementById('confirm-message').textContent = message;
    modal.style.display = 'flex';

    const okBtn = document.getElementById('confirm-ok');
    const cancelBtn = document.getElementById('confirm-cancel');

    const cleanup = (result) => {
      modal.style.display = 'none';
      okBtn.removeEventListener('click', onOk);
      cancelBtn.removeEventListener('click', onCancel);
      resolve(result);
    };

    const onOk = () => cleanup(true);
    const onCancel = () => cleanup(false);
    okBtn.addEventListener('click', onOk);
    cancelBtn.addEventListener('click', onCancel);
  });
}

// ====== パンくずリスト ======
function updateBreadcrumb() {
  const bc = document.getElementById('breadcrumb');
  if (!bc) return;
  const items = [];

  items.push({ label: 'ホーム', action: () => navigateTo('home') });

  if (state.currentDrawingId) {
    const name = getDrawingName(state.currentDrawingId);
    items.push({ label: `図面: ${name}`, action: () => navigateTo('poles', state.currentDrawingId) });
  }
  if (state.currentPoleId) {
    const name = getPoleName(state.currentPoleId);
    items.push({ label: `電柱: ${name}`, action: () => navigateTo('categories', state.currentDrawingId, state.currentPoleId) });
  }
  for (let i = 0; i < state.currentCategoryPath.length; i++) {
    const cat = state.currentCategoryPath[i];
    const isLast = i === state.currentCategoryPath.length - 1;
    if (isLast) {
      items.push({ label: cat.name, action: null });
    } else {
      const catId = cat.id;
      items.push({ label: cat.name, action: () => navigateTo('subcategories', state.currentDrawingId, state.currentPoleId, catId) });
    }
  }

  bc.innerHTML = items.map((item, i) => {
    const isLast = i === items.length - 1;
    const sep = i > 0 ? '<span class="breadcrumb-sep">›</span>' : '';
    return `${sep}<span class="breadcrumb-item ${isLast ? 'current' : ''}" data-idx="${i}">${item.label}</span>`;
  }).join('');

  bc.querySelectorAll('.breadcrumb-item:not(.current)').forEach((el) => {
    const idx = parseInt(el.dataset.idx);
    el.addEventListener('click', () => {
      if (items[idx]?.action) items[idx].action();
    });
  });
}

