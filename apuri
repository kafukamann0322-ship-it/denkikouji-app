      <button class="btn btn-secondary btn-full" id="camera-retake-btn">🔄 撮り直し</button>
      <button class="btn btn-success btn-full" id="camera-confirm-btn">✅ 確定して続ける</button>
    </div>
  </div>
</div>

<!-- ====== プログレスオーバーレイ ====== -->
<div class="progress-overlay" id="progress-overlay" style="display:none" aria-live="polite">
