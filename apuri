// ====== 画面6: カメラ撮影 ======
async function openCameraScreen(drawingId, poleId, categoryStage) {
  const [categoryId, stage] = categoryStage.split('|');
  state.currentStage = stage;
  state.currentCategoryId = categoryId;

  const cameraView = document.getElementById('camera-view');
  cameraView.style.display = 'flex';

  const video = document.getElementById('camera-video');
  const guide = document.getElementById('camera-guide');
  const previewImg = document.getElementById('camera-preview-img');
  const previewOverlay = document.getElementById('camera-preview-overlay');

  // ガイド枠サイズ設定（4:3）
  const setGuideSize = () => {
    const vw = video.clientWidth;
    const vh = video.clientHeight;
    const gw = Math.min(vw * 0.85, (vh * 0.85) * (4/3));
    const gh = gw * (3/4);
    guide.style.width = gw + 'px';
    guide.style.height = gh + 'px';
  };
  setTimeout(setGuideSize, 300);

  // カメラ起動
  try {
    await startCamera(video);
    setGuideSize();
  } catch (e) {
    cameraView.style.display = 'none';
    let msg = 'カメラを起動できませんでした。';
    if (e.message === 'CAMERA_PERMISSION_DENIED') {
      msg = 'HTTPS環境（またはPWA）でカメラ権限を許可して実行してください。';
    } else if (e.message === 'CAMERA_NOT_FOUND') {
      msg = 'カメラが見つかりません。';
    } else if (e.message === 'CAMERA_NOT_SUPPORTED') {
      msg = 'お使いのブラウザはカメラをサポートしていません。';
    }
    showError(msg);
    navigateTo('workscreen', drawingId, poleId, categoryId);
    return;
  }

  // ステージ表示
  document.getElementById('camera-stage-label').textContent = stage;

  let capturedBlob = null;

  // カメラ
  document.getElementById('shutter-btn').onclick = async () => {
    try {
      capturedBlob = await captureFrame(video);
      const dataURL = await blobToDataURL(capturedBlob);
      previewImg.src = dataURL;
      previewOverlay.style.display = 'flex';
    } catch (e) {
      showError('撮影処理に失敗しました: ' + e.message);
    }
  };

  // 撮り直し
  document.getElementById('camera-retake-btn').onclick = () => {
    previewOverlay.style.display = 'none';
    capturedBlob = null;
  };

  // 確定して続ける
  document.getElementById('camera-confirm-btn').onclick = async () => {
    if (!capturedBlob) return;
    try {
      const dataURL = await blobToDataURL(capturedBlob);
      const photo = {
        id: uid(),
        categoryId,
        stage,
        dataURL,
        createdAt: Date.now()
      };
      const result = await safeSave(() => savePhoto(photo));
      if (result === null) return;
      capturedBlob = null;
      previewOverlay.style.display = 'none';
      showToast('写真を保存しました', 'success');
    } catch (e) {
      showError('写真の保存に失敗しました: ' + e.message);
    }
  };

  // カメラを閉じる
  document.getElementById('camera-close-btn').onclick = () => {
    stopCamera();
    cameraView.style.display = 'none';
    navigateTo('workscreen', drawingId, poleId, categoryId);
  };
}

