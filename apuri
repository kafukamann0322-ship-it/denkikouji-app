        <label class="toggle-switch" title="${stage}の使用設定">
          <input type="checkbox" class="stage-toggle" data-stage="${stage}" ${enabled ? 'checked' : ''}>
          <span class="toggle-track"></span>
        </label>
        <span style="font-size:10px;color:var(--text-muted)">${enabled ? '使用する' : '使用しない'}</span>
      </div>
    `;
  }).join('');

  // サムネイル表示
  const thumbContainer = document.getElementById('thumbnails-container');
  thumbContainer.innerHTML = '';
  for (const stage of stages) {
    const stagePhotos = photos.filter(p => p.stage === stage);
    if (stagePhotos.length > 0) {
      const section = document.createElement('div');
      section.innerHTML = `<div class="section-title">${stage}（${stagePhotos.length}枚）</div>`;
      const grid = document.createElement('div');
      grid.className = 'thumb-grid';
      for (const photo of stagePhotos) {
        const div = document.createElement('div');
        div.className = 'thumb-item';
        div.innerHTML = `<img src="${photo.dataURL}" alt="${stage}" loading="lazy">`;
        div.addEventListener('click', () => openPhotoPreview(photo, categoryId, stage));
        grid.appendChild(div);
      }
      section.appendChild(grid);
      thumbContainer.appendChild(section);
    }
  }

  // ステージボタンイベント
  container.querySelectorAll('.stage-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const stage = btn.dataset.stage;
      const enabled = btn.dataset.enabled === 'true';
      if (!enabled) return;
      navigateTo('camera', state.currentDrawingId, state.currentPoleId, categoryId + '|' + stage);
    });
  });

  // トグルスイッチ
  container.querySelectorAll('.stage-toggle').forEach(toggle => {
    toggle.addEventListener('change', async () => {
      const stage = toggle.dataset.stage;
      const enabled = toggle.checked;
      const catData = await getCategoryData(categoryId);
      if (!catData) return;
      catData.enabledStages = catData.enabledStages || { '事前': true, '中': true, '事後': true };
      catData.enabledStages[stage] = enabled;
      await safeSave(() => saveCategory(catData));
      // ラベル更新
      const label = toggle.closest('div').querySelector('span:last-child');
      if (label) label.textContent = enabled ? '使用する' : '使用しない';
    });
  });
}

async function renderMaterialList(categoryId, cat) {
  const masterRec = state.masterData || INITIAL_MASTER;
  const existingMaterials = await getMaterialsByCategory(categoryId);

  // マスターから材料を取得（大工種に対応するもの）
  const allMaterials = masterRec.materials || [];

  // 工種名からジャンルを推測（最上位工種名 = ジャンル）
  const rootCat = state.currentCategoryPath[0];
  const genre = rootCat?.name || '';

  // マスター材料 + 既存材料をマージ
  const masterMats = allMaterials.filter(m =>
    genre === '' || m.genre === genre || allMaterials.some(am => am.name === m.name)
  );

  // 既存のDB材料と合わせてリスト作成
  const materialMap = new Map();

  // 既存材料を優先
  for (const m of existingMaterials) {
    materialMap.set(m.name, m);
  }

  // マスターから未登録の材料を追加（qty=0）
  for (const m of masterMats) {
    if (!materialMap.has(m.name)) {
      materialMap.set(m.name, {
        id: uid(),
        categoryId,
        name: m.name,
        qty: 0,
        fixedQty: 0,
        isFixed: false,
        usageCount: 0
      });
    }
  }

  const materials = [...materialMap.values()];

  // 固定適用: 新規開かれた場合に固定数量を自動適用
  for (const m of materials) {
    if (m.isFixed && m.fixedQty > 0 && m.qty === 0) {
      m.qty = m.fixedQty;
      await safeSave(() => saveMaterial(m));
    }
  }

  // 使用頻度順でソート（qty>0 を上に）
  materials.sort((a, b) => {
    if (a.qty > 0 && b.qty === 0) return -1;
    if (a.qty === 0 && b.qty > 0) return 1;
    return (b.usageCount || 0) - (a.usageCount || 0);
  });

  const container = document.getElementById('material-list');
  container.innerHTML = '';

  for (const mat of materials) {
    const item = document.createElement('div');
    item.className = `material-item ${mat.qty > 0 ? 'has-qty' : ''} ${mat.isFixed ? 'fixed-on' : ''}`;
    item.id = `mat-item-${mat.id}`;
    item.innerHTML = `
      <div style="display:flex;flex-direction:column;flex:1;min-width:0">
        <span class="material-name">${mat.name}</span>
        ${mat.isFixed ? `<span style="font-size:10px;color:var(--accent-yellow)">固定: ${mat.fixedQty}個</span>` : ''}
      </div>
      <div class="qty-counter">
        <button class="qty-btn minus" data-mat-id="${mat.id}">－</button>
        <input type="number" class="qty-display" value="${mat.qty}" min="0" data-mat-id="${mat.id}" style="width:56px;text-align:center">
        <button class="qty-btn plus" data-mat-id="${mat.id}">＋</button>
      </div>
      <label class="toggle-switch" title="固定設定">
        <input type="checkbox" class="fix-toggle" data-mat-id="${mat.id}" ${mat.isFixed ? 'checked' : ''}>
        <span class="toggle-track"></span>
      </label>
    `;
    container.appendChild(item);

    // 数量変更
    const updateQty = async (newQty) => {
      mat.qty = Math.max(0, parseInt(newQty) || 0);
      mat.usageCount = (mat.usageCount || 0) + (mat.qty > 0 ? 1 : 0);
      const result = await safeSave(() => saveMaterial(mat));
      if (result !== null) {
        const el = document.getElementById(`mat-item-${mat.id}`);
        if (el) {
          el.className = `material-item ${mat.qty > 0 ? 'has-qty' : ''} ${mat.isFixed ? 'fixed-on' : ''}`;
        }
        const qtyEl = item.querySelector(`.qty-display[data-mat-id="${mat.id}"]`);
        if (qtyEl) qtyEl.value = mat.qty;
      }
    };

    item.querySelector(`.minus[data-mat-id="${mat.id}"]`)?.addEventListener('click', () => updateQty(mat.qty - 1));
    item.querySelector(`.plus[data-mat-id="${mat.id}"]`)?.addEventListener('click', () => updateQty(mat.qty + 1));
    item.querySelector(`.qty-display[data-mat-id="${mat.id}"]`)?.addEventListener('change', (e) => updateQty(e.target.value));

    // 固定トグル
    item.querySelector(`.fix-toggle[data-mat-id="${mat.id}"]`)?.addEventListener('change', async (e) => {
      mat.isFixed = e.target.checked;
      mat.fixedQty = mat.isFixed ? mat.qty : 0;
      await safeSave(() => saveMaterial(mat));
      const el = document.getElementById(`mat-item-${mat.id}`);
      if (el) el.className = `material-item ${mat.qty > 0 ? 'has-qty' : ''} ${mat.isFixed ? 'fixed-on' : ''}`;
    });
  }

  if (materials.length === 0) {
    container.innerHTML = `<div class="empty-state"><div class="empty-text">材料マスターが設定されていません<br>設定から取り込んでください</div></div>`;
  }
}

