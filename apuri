// ====== SPA ルーティング ======
let _routeData = {};

function navigateTo(screen, ...args) {
  _routeData = { screen, args };
  history.pushState(_routeData, '', '#' + screen);
  renderScreen(screen, args);
}

window.onpopstate = (event) => {
  if (event.state) {
    const { screen, args } = event.state;
    renderScreen(screen, args || []);
  } else {
    renderScreen('home', []);
  }
};

// 離脱防止
window.addEventListener('beforeunload', (e) => {
  e.preventDefault();
  e.returnValue = 'データが失われる可能性があります。ページを離れますか？';
});

function renderScreen(screen, args = []) {
  // 全画面非表示
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));

  // カメラ停止（カメラ画面以外）
  if (screen !== 'camera') {
    stopCamera();
    const cameraView = document.getElementById('camera-view');
    if (cameraView) cameraView.style.display = 'none';
  }

  switch (screen) {
    case 'home': renderHome(); break;
    case 'poles': renderPoles(args[0]); break;
    case 'categories': renderCategories(args[0], args[1], null, 0); break;
    case 'subcategories': renderCategories(args[0], args[1], args[2], null); break;
    case 'workscreen': renderWorkScreen(args[0], args[1], args[2]); break;
    case 'materials': renderMaterialsAgg(args[0]); break;
    case 'camera': openCameraScreen(args[0], args[1], args[2]); break;
    default: renderHome();
  }
  updateBreadcrumb();
}

