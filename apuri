// camera.js - カメラ撮影・CALS/EC対応画像処理モジュール

let currentStream = null;

/**
 * バックカメラを起動してストリームを返す
 */
export async function startCamera(videoElement) {
  try {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      throw new Error('API_UNSUPPORTED');
    }
    const constraints = {
      video: {
        facingMode: { ideal: 'environment' },
        width: { ideal: 1920 },
        height: { ideal: 1440 }
      },
      audio: false
    };
    currentStream = await navigator.mediaDevices.getUserMedia(constraints);
    videoElement.srcObject = currentStream;
    await new Promise(resolve => {
      videoElement.onloadedmetadata = () => {
        videoElement.play();
        resolve();
      };
    });
    return currentStream;
  } catch (e) {
    if (e.name === 'NotAllowedError' || e.name === 'PermissionDeniedError') {
      throw new Error('CAMERA_PERMISSION_DENIED');
    } else if (e.name === 'NotFoundError' || e.name === 'DevicesNotFoundError') {
      throw new Error('CAMERA_NOT_FOUND');
    } else if (e.message === 'API_UNSUPPORTED') {
      throw new Error('CAMERA_NOT_SUPPORTED');
    } else {
      throw new Error('CAMERA_ERROR:' + e.message);
    }
  }
}

/**
 * カメラストリームを停止
 */
export function stopCamera() {
  if (currentStream) {
    currentStream.getTracks().forEach(track => track.stop());
    currentStream = null;
  }
}

/**
 * Exif方向情報を取得（JPEG Blobから）
 */
async function getExifOrientation(blob) {
  try {
    const buffer = await blob.arrayBuffer();
    const view = new DataView(buffer);
    if (view.getUint16(0, false) !== 0xFFD8) return 1; // Not JPEG
    let offset = 2;
    while (offset < view.byteLength) {
      const marker = view.getUint16(offset, false);
      offset += 2;
      if (marker === 0xFFE1) { // APP1 (Exif)
        const exifData = new DataView(buffer, offset + 2);
        const littleEndian = exifData.getUint16(0) === 0x4949;
        const ifdOffset = exifData.getUint32(4, littleEndian);
        const entries = exifData.getUint16(ifdOffset, littleEndian);
        for (let i = 0; i < entries; i++) {
          const entryOffset = ifdOffset + 2 + i * 12;
          if (exifData.getUint16(entryOffset, littleEndian) === 0x0112) {
            return exifData.getUint16(entryOffset + 8, littleEndian);
          }
        }
      } else if ((marker & 0xFF00) !== 0xFF00) break;
      else offset += view.getUint16(offset, false);
    }
  } catch (e) { /* ignore */ }
  return 1;
}

/**
 * CALS/EC対応: 4:3クロップ + 長辺1920px/短辺1440px + JPEG 0.85
 * @param {Blob|string} source - Blob または base64 data URL
 * @returns {Promise<Blob>} 処理済みJPEG Blob
 */
export async function processImageCALS(source) {
  return new Promise(async (resolve, reject) => {
    try {
      let blob = source instanceof Blob ? source : await (await fetch(source)).blob();
      const orientation = await getExifOrientation(blob);
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        let sw = img.naturalWidth;
        let sh = img.naturalHeight;

        // Exif回転補正が必要か
        const needsRotation = orientation >= 5;
        const imgW = needsRotation ? sh : sw;
        const imgH = needsRotation ? sw : sh;

        // 4:3クロップ計算
        const targetRatio = 4 / 3;
        const imgRatio = imgW / imgH;
        let cropW, cropH, cropX, cropY;
        if (imgRatio > targetRatio) {
          // 横長すぎ → 横をクロップ
          cropH = imgH;
          cropW = Math.round(imgH * targetRatio);
          cropX = Math.round((imgW - cropW) / 2);
          cropY = 0;
        } else {
          // 縦長すぎ → 縦をクロップ
          cropW = imgW;
          cropH = Math.round(imgW / targetRatio);
          cropX = 0;
          cropY = Math.round((imgH - cropH) / 2);
        }

        // 出力サイズ（長辺1920、短辺1440）
        const outW = 1920;
        const outH = 1440;
        canvas.width = outW;
        canvas.height = outH;

        ctx.save();
        // Exif回転補正
        switch (orientation) {
          case 2: ctx.transform(-1, 0, 0, 1, outW, 0); break;
          case 3: ctx.transform(-1, 0, 0, -1, outW, outH); break;
          case 4: ctx.transform(1, 0, 0, -1, 0, outH); break;
          case 5: ctx.transform(0, 1, 1, 0, 0, 0); break;
          case 6: ctx.transform(0, 1, -1, 0, outH, 0); break;
          case 7: ctx.transform(0, -1, -1, 0, outH, outW); break;
          case 8: ctx.transform(0, -1, 1, 0, 0, outW); break;
          default: break;
        }

        // Exif回転が必要な場合はsrc座標を元画像基準に変換
        if (needsRotation) {
          ctx.drawImage(img, cropY, cropX, cropH, cropW, 0, 0, outH, outW);
        } else {
          ctx.drawImage(img, cropX, cropY, cropW, cropH, 0, 0, outW, outH);
        }
        ctx.restore();

        canvas.toBlob((resultBlob) => {
          if (resultBlob) resolve(resultBlob);
          else reject(new Error('Canvas toBlob failed'));
        }, 'image/jpeg', 0.85);
      };
      img.onerror = () => reject(new Error('Image load failed'));
      img.src = url;
    } catch (e) {
      reject(e);
    }
  });
}

/**
 * Videoフレームをキャプチャして処理済みBlobを返す
 * @param {HTMLVideoElement} videoElement
 * @returns {Promise<Blob>}
 */
export async function captureFrame(videoElement) {
  const tempCanvas = document.createElement('canvas');
  tempCanvas.width = videoElement.videoWidth;
  tempCanvas.height = videoElement.videoHeight;
  const ctx = tempCanvas.getContext('2d');
  ctx.drawImage(videoElement, 0, 0);
  const blob = await new Promise(resolve => tempCanvas.toBlob(resolve, 'image/jpeg', 0.95));
  return processImageCALS(blob);
}

/**
 * BlobをBase64 data URLに変換
 */
export function blobToDataURL(blob) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(blob);
  });
}

/**
 * Base64 data URLをBlobに変換
 */
export function dataURLToBlob(dataURL) {
  const arr = dataURL.split(',');
  const mime = arr[0].match(/:(.*?);/)[1];
  const bstr = atob(arr[1]);
  let n = bstr.length;
  const u8arr = new Uint8Array(n);
  while (n--) u8arr[n] = bstr.charCodeAt(n);
  return new Blob([u8arr], { type: mime });
}

