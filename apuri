async function renderCategories(drawingId, poleId, parentId, depth) {
  state.currentDrawingId = drawingId;
  state.currentPoleId = poleId;

  const screen = document.getElementById('screen-categories');
  screen.classList.add('active');

  // 親IDがnullなら最上位（大工種）
  const actualParentId = parentId;

  // カテゴリ取得
  let cats;
  if (!actualParentId) {
    // 最上位: poleIdに紐づく、parentId=nullのもの
    const all = await getCategoriesByPole(poleId);
    cats = all.filter(c => !c.parentId).sort((a, b) => a.createdAt - b.createdAt);
  } else {
    cats = (await getCategoriesByParent(actualParentId)).sort((a, b) => a.createdAt - b.createdAt);
  }

  // パスの更新
  if (!actualParentId) {
    state.currentCategoryPath = [];
  }

  const titleEl = document.getElementById('categories-title');
  if (titleEl) {
    const pole = getPoleName(poleId);
    const depth = state.currentCategoryPath.length;
    const depthLabel = depth === 0 ? '大工種' : depth === 1 ? '中工種' : '小工種';
    titleEl.textContent = `${depthLabel}一覧（電柱: ${pole}）`;
  }

  await loadCategoryList(drawingId, poleId, actualParentId, cats);

  document.getElementById('categories-back-btn')?.onclick = () => {
    if (state.currentCategoryPath.length > 0) {
      const prev = state.currentCategoryPath[state.currentCategoryPath.length - 2];
      state.currentCategoryPath.pop();
      navigateTo('subcategories', drawingId, poleId, prev?.id || null);
    } else {
      navigateTo('poles', drawingId);
    }
  };
}

async function loadCategoryList(drawingId, poleId, parentId, cats) {
  const list = document.getElementById('category-list');
  const depth = state.currentCategoryPath.length;

  if (cats.length === 0) {
    list.innerHTML = `
      <div class="empty-state">
        <div class="empty-icon">🔧</div>
        <div class="empty-text">工種を追加してください</div>
      </div>`;
  } else {
    list.innerHTML = cats.map(cat => {
      const isLeaf = cat.isLeaf !== false; // デフォルトはleaf
      // 子があるか確認済みならそれを使う
      const leafClass = cat.hasChildren ? '' : 'leaf';
      return `
        <div class="category-btn ${cat.hasChildren ? '' : 'leaf'}" id="cat-btn-${cat.id}" data-cat-id="${cat.id}" data-has-children="${cat.hasChildren || false}">
          <span style="font-size:20px">${cat.hasChildren ? '📁' : '📌'}</span>
          <span style="flex:1;font-size:15px;font-weight:600">${cat.name}</span>
          <span class="chevron">›</span>
          ${state.deleteMode ? `<button class="btn btn-danger btn-sm" id="del-cat-${cat.id}" data-cat-id="${cat.id}" style="margin-left:4px">🗑️</button>` : ''}
        </div>
      `;
    }).join('');
  }

  // 子工種追加フォーム（大・中工種にのみ表示 / 深さ2まで）
  const addSection = document.getElementById('add-category-section');
  if (addSection) {
    const maxDepth = 2; // 0=大,1=中,2=小（最大3段階）
    addSection.style.display = depth <= maxDepth ? 'flex' : 'none';
    const placeholder = ['大工種名を入力', '中工種名を入力', '小工種名を入力'][depth] || '工種名を入力';
    const inp = document.getElementById('category-input');
    if (inp) inp.placeholder = placeholder;
  }

  // イベント設定
  list.querySelectorAll('.category-btn').forEach(btn => {
    const catId = btn.dataset.catId;
    const hasChildren = btn.dataset.hasChildren === 'true';

    btn.addEventListener('click', async (e) => {
      if (e.target.closest('button')) return;

      const cat = cats.find(c => c.id === catId);
      if (!cat) return;

      // 子があるか確認
      const children = await getCategoriesByParent(catId);
      if (children.length > 0) {
        // 親工種→子工種へ遷移
        state.currentCategoryPath.push({ id: catId, name: cat.name });
        updateBreadcrumb();
        const subCats = children.sort((a, b) => a.createdAt - b.createdAt);
        // 子カテゴリの hasChildren を確認
        for (const child of subCats) {
          const grandChildren = await getCategoriesByParent(child.id);
          child.hasChildren = grandChildren.length > 0;
        }
        state.currentCategoryPath[state.currentCategoryPath.length - 1].id = catId;
        await loadCategoryList(drawingId, poleId, catId, subCats);
        document.getElementById('categories-title').textContent = `工種一覧（電柱: ${getPoleName(poleId)}）`;
        history.pushState({ screen: 'subcategories', args: [drawingId, poleId, catId] }, '', '#subcategories');
        return;
      }

      // 末端工種→作業画面へ
      state.currentCategoryPath.push({ id: catId, name: cat.name });
      state.currentCategoryId = catId;
      navigateTo('workscreen', drawingId, poleId, catId);
    });
  });

  // 削除ボタン
  list.querySelectorAll('[id^="del-cat-"]').forEach(btn => {
    const catId = btn.dataset.catId;
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const cat = cats.find(c => c.id === catId);
      const ok = await confirm('工種削除', `「${cat?.name}」を削除します。\n紐づく子工種・写真・材料も全て削除されます。よろしいですか？`);
      if (ok) {
        await deleteCategory(catId);
        const refreshed = parentId
          ? (await getCategoriesByParent(parentId)).sort((a, b) => a.createdAt - b.createdAt)
          : (await getCategoriesByPole(poleId)).filter(c => !c.parentId).sort((a, b) => a.createdAt - b.createdAt);
        for (const c of refreshed) {
          const ch = await getCategoriesByParent(c.id);
          c.hasChildren = ch.length > 0;
        }
        await loadCategoryList(drawingId, poleId, parentId, refreshed);
        showToast('工種を削除しました', 'success');
      }
    });
  });
}

