  return result;
}

/**
 * PDF生成（A4縦・日本語対応）
 * @param {string} drawingName
 * @param {Array} materials - [{name, qty}]
 * @returns {Promise<Blob>}
 */
export async function generateMaterialPDF(drawingName, materials) {
  // html2canvasでDOMをCanvas化してjsPDFに埋め込む
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

  // PDF生成用の非表示DOM作成
  const container = document.createElement('div');
  container.style.cssText = `
    position: fixed; left: -9999px; top: 0;
    width: 794px; background: white; padding: 40px;
    font-family: 'Noto Sans JP', sans-serif; color: #000;
  `;

  const today = new Date();
  const dateStr = `${today.getFullYear()}/${String(today.getMonth()+1).padStart(2,'0')}/${String(today.getDate()).padStart(2,'0')}`;

  let tableRows = materials.map((m, i) => `
    <tr style="border-bottom: 1px solid #ccc;">
      <td style="padding:6px 8px; text-align:center; border-right:1px solid #ccc; width:40px;">${i+1}</td>
      <td style="padding:6px 8px; border-right:1px solid #ccc;">${m.name}</td>
      <td style="padding:6px 8px; text-align:center; border-right:1px solid #ccc; width:60px;">${m.qty}</td>
      <td style="padding:6px 8px; text-align:center; width:40px;">個</td>
    </tr>
  `).join('');

  container.innerHTML = `
    <div style="margin-bottom:20px;">
      <h1 style="font-size:20px; font-weight:bold; margin:0 0 8px 0;">
        図面番号: ${drawingName} 使用材料集計表
      </h1>
      <p style="font-size:13px; color:#555; margin:0;">作成日時: ${dateStr}</p>
    </div>
    <table style="width:100%; border-collapse:collapse; border:2px solid #333; font-size:14px;">
      <thead>
        <tr style="background:#1e293b; color:white;">
          <th style="padding:8px; text-align:center; border-right:1px solid #4a5568; width:40px;">No</th>
          <th style="padding:8px; text-align:left; border-right:1px solid #4a5568;">材料名</th>
          <th style="padding:8px; text-align:center; border-right:1px solid #4a5568; width:60px;">数量</th>
          <th style="padding:8px; text-align:center; width:40px;">単位</th>
        </tr>
      </thead>
      <tbody>${tableRows}</tbody>
    </table>
    <p style="font-size:11px; color:#888; margin-top:12px;">総材料数: ${materials.length}品目</p>
  `;
  document.body.appendChild(container);

  try {
    const canvas = await html2canvas(container, {
      scale: 2,
      useCORS: true,
      backgroundColor: '#ffffff'
    });
    document.body.removeChild(container);

    const imgData = canvas.toDataURL('image/jpeg', 0.95);
    const pageW = 210; // A4幅mm
    const pageH = 297; // A4高さmm
    const margin = 10;
    const availW = pageW - margin * 2;
    const imgW = canvas.width;
    const imgH = canvas.height;
    const ratio = availW / imgW;
    let y = margin;
    let remainH = imgH;
    let srcY = 0;

    // 複数ページ対応
    while (remainH > 0) {
      const pageAvailH = pageH - margin * 2;
      const printH = Math.min(remainH * ratio, pageAvailH);
      const srcH = printH / ratio;

      const pageCanvas = document.createElement('canvas');
      pageCanvas.width = imgW;
      pageCanvas.height = srcH;
      const ctx = pageCanvas.getContext('2d');
      ctx.drawImage(canvas, 0, srcY, imgW, srcH, 0, 0, imgW, srcH);
      const pageImgData = pageCanvas.toDataURL('image/jpeg', 0.95);

      if (srcY > 0) doc.addPage();
      doc.addImage(pageImgData, 'JPEG', margin, margin, availW, printH);

      srcY += srcH;
      remainH -= srcH;
    }

    return doc.output('blob');
  } catch (e) {
    if (document.body.contains(container)) document.body.removeChild(container);
    throw e;
  }
}

/**
 * ZIP生成・出力
 * @param {Object} params
 */
export async function generateZIP({
  drawingName,
  date,
  polesData,
  materials,
  onProgress
}) {
  const JSZip = window.JSZip;
  const zip = new JSZip();

  const dateFolder = date || new Date().toISOString().slice(0, 10);
  const drawingFolder = zip.folder(`${dateFolder}/${drawingName}`);

  let totalPhotos = 0;
  let processedPhotos = 0;

  // 写真数カウント
  for (const pole of polesData) {
    for (const cat of pole.categories) {
      for (const stage of ['事前', '中', '事後']) {
        const photos = cat.photos?.[stage] || [];
        if (photos.length > 0) totalPhotos += photos.length;
      }
    }
  }

  // ZIP構造生成（空フォルダ排除ロジック）
  for (const pole of polesData) {
    for (const cat of pole.categories) {
      // カテゴリパス（例: 大工種/中工種/小工種）
      const pathParts = cat.pathNames || [cat.name];

      for (const stage of ['事前', '中', '事後']) {
        const photos = cat.photos?.[stage] || [];
        // 写真が存在する場合のみフォルダ生成（空フォルダ排除）
        if (photos.length === 0) continue;

        // フォルダパス: 日付/図面番号/電柱番号/[大工種/[中工種/[小工種]]]
        const folderPath = [pole.name, ...pathParts].join('/');
        let folder = drawingFolder;
        for (const part of [pole.name, ...pathParts]) {
          folder = folder.folder(part);
        }

        for (let i = 0; i < photos.length; i++) {
          const photo = photos[i];
          const num = String(i + 1).padStart(2, '0');
          const catName = pathParts[pathParts.length - 1]; // 最末端工種名
          const fileName = `${pole.name}_${catName}_${stage}_${num}.jpg`;

          let blob;
          if (photo.dataURL) {
            const arr = photo.dataURL.split(',');
            const bstr = atob(arr[1]);
            const u8arr = new Uint8Array(bstr.length);
            for (let j = 0; j < bstr.length; j++) u8arr[j] = bstr.charCodeAt(j);
            blob = new Blob([u8arr], { type: 'image/jpeg' });
          } else if (photo.blob) {
            blob = photo.blob;
          }

          if (blob) {
            folder.file(fileName, blob);
          }

          processedPhotos++;
          if (onProgress) {
            onProgress(Math.round((processedPhotos / totalPhotos) * 80));
          }
        }
      }
    }
  }

  // PDF生成して追加
  if (onProgress) onProgress(85);
  try {
    const pdfBlob = await generateMaterialPDF(drawingName, materials);
    zip.file('総材料数.pdf', pdfBlob);
  } catch (e) {
    console.error('PDF生成エラー:', e);
  }

  if (onProgress) onProgress(95);

  // ZIP生成
  const zipBlob = await zip.generateAsync({
    type: 'blob',
    compression: 'DEFLATE',
    compressionOptions: { level: 6 }
  }, (metadata) => {
    if (onProgress && metadata.percent) {
      // 95〜100%の範囲で更新
    }
  });

  if (onProgress) onProgress(100);
  return zipBlob;
}

/**
 * ファイル保存（ブラウザダウンロード）
 */
export function downloadFile(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 5000);
}

