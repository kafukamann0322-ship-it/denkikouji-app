// db.js - IndexedDB操作モジュール
const DB_NAME = 'ConstructionPhotoApp';
const DB_VERSION = 1;

let db = null;

export async function initDB() {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open(DB_NAME, DB_VERSION);

    request.onupgradeneeded = (event) => {
      const db = event.target.result;

      // 図面番号
      if (!db.objectStoreNames.contains('drawings')) {
        const drawingStore = db.createObjectStore('drawings', { keyPath: 'id' });
        drawingStore.createIndex('createdAt', 'createdAt', { unique: false });
      }

      // 電柱番号
      if (!db.objectStoreNames.contains('poles')) {
        const poleStore = db.createObjectStore('poles', { keyPath: 'id' });
        poleStore.createIndex('drawingId', 'drawingId', { unique: false });
        poleStore.createIndex('createdAt', 'createdAt', { unique: false });
      }

      // 工種（階層）
      if (!db.objectStoreNames.contains('categories')) {
        const catStore = db.createObjectStore('categories', { keyPath: 'id' });
        catStore.createIndex('poleId', 'poleId', { unique: false });
        catStore.createIndex('parentId', 'parentId', { unique: false });
      }

      // 工種別材料使用量
      if (!db.objectStoreNames.contains('materials')) {
        const matStore = db.createObjectStore('materials', { keyPath: 'id' });
        matStore.createIndex('categoryId', 'categoryId', { unique: false });
      }

      // 写真
      if (!db.objectStoreNames.contains('photos')) {
        const photoStore = db.createObjectStore('photos', { keyPath: 'id' });
        photoStore.createIndex('categoryId', 'categoryId', { unique: false });
        photoStore.createIndex('stage', 'stage', { unique: false });
      }

      // 図面単位の手動調整値
      if (!db.objectStoreNames.contains('adjustments')) {
        db.createObjectStore('adjustments', { keyPath: 'id' });
      }

      // マスターデータ
      if (!db.objectStoreNames.contains('master')) {
        db.createObjectStore('master', { keyPath: 'id' });
      }

      // 設定
      if (!db.objectStoreNames.contains('settings')) {
        db.createObjectStore('settings', { keyPath: 'key' });
      }
    };

    request.onsuccess = (event) => {
      db = event.target.result;
      resolve(db);
    };

    request.onerror = (event) => {
      reject(event.target.error);
    };
  });
}

function getDB() {
  if (!db) throw new Error('DB not initialized');
  return db;
}

// ---- 汎用CRUD ----

export async function dbGet(storeName, key) {
  return new Promise((resolve, reject) => {
    const tx = getDB().transaction(storeName, 'readonly');
    const store = tx.objectStore(storeName);
    const req = store.get(key);
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

export async function dbGetAll(storeName) {
  return new Promise((resolve, reject) => {
    const tx = getDB().transaction(storeName, 'readonly');
    const store = tx.objectStore(storeName);
    const req = store.getAll();
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

export async function dbGetAllByIndex(storeName, indexName, value) {
  return new Promise((resolve, reject) => {
    const tx = getDB().transaction(storeName, 'readonly');
    const store = tx.objectStore(storeName);
    const index = store.index(indexName);
    const req = index.getAll(value);
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

async function dbPut(storeName, data) {
  return new Promise((resolve, reject) => {
    const tx = getDB().transaction(storeName, 'readwrite');
    const store = tx.objectStore(storeName);
    const req = store.put(data);
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
    tx.onerror = () => reject(tx.error);
  });
}

export async function dbSave(storeName, data) {
  try {
    return await dbPut(storeName, data);
  } catch (e) {
    if (e.name === 'QuotaExceededError' || (e.message && e.message.includes('quota'))) {
      throw new Error('QUOTA_EXCEEDED');
    }
    throw e;
  }
}

export async function dbDelete(storeName, key) {
  return new Promise((resolve, reject) => {
    const tx = getDB().transaction(storeName, 'readwrite');
    const store = tx.objectStore(storeName);
    const req = store.delete(key);
    req.onsuccess = () => resolve();
    req.onerror = () => reject(req.error);
  });
}

// ---- 図面 ----

export async function saveDrawing(drawing) {
  return dbSave('drawings', drawing);
}

export async function getAllDrawings() {
  const all = await dbGetAll('drawings');
  return all.sort((a, b) => a.createdAt - b.createdAt);
}

export async function deleteDrawing(drawingId) {
  // 関連データ全削除
  const poles = await getPolesByDrawing(drawingId);
  for (const pole of poles) {
    await deletePole(pole.id);
  }
  // 手動調整値削除
  const adjustments = await dbGetAll('adjustments');
  for (const adj of adjustments) {
    if (adj.drawingId === drawingId) {
      await dbDelete('adjustments', adj.id);
    }
  }
  await dbDelete('drawings', drawingId);
}

// ---- 電柱 ----

export async function savePole(pole) {
  return dbSave('poles', pole);
}

export async function getPolesByDrawing(drawingId) {
  const all = await dbGetAllByIndex('poles', 'drawingId', drawingId);
  return all.sort((a, b) => a.createdAt - b.createdAt);
}

export async function deletePole(poleId) {
  const categories = await getCategoriesByPole(poleId);
  for (const cat of categories) {
    await deleteCategory(cat.id);
  }
  await dbDelete('poles', poleId);
}

// ---- 工種（カテゴリ）----

export async function saveCategory(category) {
  return dbSave('categories', category);
}

export async function getCategoriesByPole(poleId) {
  return dbGetAllByIndex('categories', 'poleId', poleId);
}

export async function getCategoriesByParent(parentId) {
  return dbGetAllByIndex('categories', 'parentId', parentId);
}

export async function deleteCategory(categoryId) {
  // 子カテゴリを再帰削除
  const children = await getCategoriesByParent(categoryId);
  for (const child of children) {
    await deleteCategory(child.id);
  }
  // 材料削除
  const mats = await dbGetAllByIndex('materials', 'categoryId', categoryId);
  for (const m of mats) {
    await dbDelete('materials', m.id);
  }
  // 写真削除
  const photos = await dbGetAllByIndex('photos', 'categoryId', categoryId);
  for (const p of photos) {
    await dbDelete('photos', p.id);
  }
  await dbDelete('categories', categoryId);
}

// ---- 材料 ----

export async function saveMaterial(material) {
  return dbSave('materials', material);
}

export async function getMaterialsByCategory(categoryId) {
  return dbGetAllByIndex('materials', 'categoryId', categoryId);
}

export async function deleteMaterial(materialId) {
  return dbDelete('materials', materialId);
}

// ---- 写真 ----

export async function savePhoto(photo) {
  return dbSave('photos', photo);
}

export async function getPhotosByCategory(categoryId) {
  return dbGetAllByIndex('photos', 'categoryId', categoryId);
}

export async function deletePhoto(photoId) {
  return dbDelete('photos', photoId);
}

// ---- 手動調整値 ----

export async function saveAdjustment(adjustment) {
  return dbSave('adjustments', adjustment);
}

export async function getAdjustmentsByDrawing(drawingId) {
  const all = await dbGetAll('adjustments');
  return all.filter(a => a.drawingId === drawingId);
}

// ---- マスターデータ ----

export async function saveMaster(masterData) {
  return dbSave('master', { id: 'master', data: masterData, updatedAt: Date.now() });
}

export async function getMaster() {
  return dbGet('master', 'master');
}

// ---- 設定 ----

export async function saveSetting(key, value) {
  return dbSave('settings', { key, value });
}

export async function getSetting(key) {
  const result = await dbGet('settings', key);
  return result ? result.value : null;
}

// ---- 初期化チェック ----

export async function isFirstRun() {
  const result = await dbGet('settings', 'initialized');
  return !result;
}

export async function markInitialized() {
  return dbSave('settings', { key: 'initialized', value: true });
}

// ---- 全データ削除（デバッグ用） ----

export async function clearAllData() {
  const stores = ['drawings', 'poles', 'categories', 'materials', 'photos', 'adjustments', 'settings'];
  for (const store of stores) {
    await new Promise((resolve, reject) => {
      const tx = getDB().transaction(store, 'readwrite');
      tx.objectStore(store).clear();
      tx.oncomplete = resolve;
      tx.onerror = reject;
    });
  }
}

