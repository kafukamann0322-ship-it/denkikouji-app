    ],
    manualAdjustments: [{ materialName: '玉がいし', manualQty: 10 }]
  };
  const result = aggregateMaterials(testData);
  const dentyu = result.find(r => r.name === '電柱札');
  const tama = result.find(r => r.name === '玉がいし');
  const shisen = result.find(r => r.name === '支線バンド5号');
