/**
 * 材料集計ロジック（純粋関数・単体テスト可能）
 * @param {Object} params
 * @param {Array} params.categoriesWithMaterials - [{categoryId, poleName, categoryPath, materials:[{name,qty}]}]
 * @param {Array} params.manualAdjustments - [{materialName, manualQty}]
 * @returns {Array} [{name, qty, isManual}]
 */
export function aggregateMaterials({ categoriesWithMaterials = [], manualAdjustments = [] }) {
  // Step1: 全材料をname単位でSUM
  const sumMap = new Map();
  for (const cat of categoriesWithMaterials) {
    for (const mat of cat.materials) {
      if (!mat.name || mat.qty <= 0) continue;
      const name = mat.name.trim();
      sumMap.set(name, (sumMap.get(name) || 0) + mat.qty);
    }
  }

  // Step2: 手動調整値があれば最優先で上書き
  const adjustMap = new Map();
  for (const adj of manualAdjustments) {
    adjustMap.set(adj.materialName, adj.manualQty);
  }

  // Step3: 結果をマージ
  const result = [];
  const allNames = new Set([...sumMap.keys(), ...adjustMap.keys()]);
  for (const name of allNames) {
    if (adjustMap.has(name)) {
      result.push({ name, qty: adjustMap.get(name), isManual: true });
    } else {
      result.push({ name, qty: sumMap.get(name), isManual: false });
    }
  }

  // 数量0以上のみ・名前順
  return result.filter(r => r.qty > 0).sort((a, b) => a.name.localeCompare(b.name, 'ja'));
}

